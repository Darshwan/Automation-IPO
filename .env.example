# Core settings
IPO_STATE_FILE=.data/seen_ipos.json
CHECK_INTERVAL_SECONDS=60

# Notification settings
NOTIFIER=console
NOTIFY_EMAIL=
NOTIFY_PHONE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# MeroShare client selection and endpoints
MEROSHARE_CLIENT=mock
MEROSHARE_LOGIN_URL=
MEROSHARE_OPEN_IPOS_URL=
MEROSHARE_APPLY_URL=
MEROSHARE_TIMEOUT_SECONDS=30.0
MEROSHARE_BROWSER_HEADLESS=true

# MeroShare access (populate securely in local .env)
MEROSHARE_DEPOSITORY_PARTICIPANT=
MEROSHARE_USERNAME=
MEROSHARE_PASSWORD=
MEROSHARE_TOTP_SECRET=
MEROSHARE_CRN_NUMBER=
MEROSHARE_TRANSACTION_PIN=
MEROSHARE_APPLY_DRY_RUN=true
MEROSHARE_LIVE_APPLY_CONFIRMATION=
MEROSHARE_LEGAL_ACKNOWLEDGED=false

# Apply flow controls
APPLY_ENABLED=false
APPLY_SHARE_QUANTITY=10

# Optional endpoints/services
MEROSHARE_BASE_URL=https://meroshare.cdsc.com.np
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
