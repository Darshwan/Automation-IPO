# Core settings
IPO_STATE_FILE=.data/seen_ipos.json
CHECK_INTERVAL_SECONDS=60

# Notification settings
NOTIFIER=console
NOTIFY_EMAIL=
NOTIFY_PHONE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# MeroShare access (populate securely in local .env)
MEROSHARE_USERNAME=
MEROSHARE_PASSWORD=
MEROSHARE_TOTP_SECRET=

# Optional endpoints/services
MEROSHARE_BASE_URL=https://meroshare.cdsc.com.np
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
